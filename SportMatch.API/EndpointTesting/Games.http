@SportMatch_HostAddress = http://localhost:5108

### Login (send first)
# @name login
POST {{SportMatch_HostAddress}}/Accounts/login
Content-Type: application/json

{ "username": "karolis123", "password": "test1234" }

### Get all games
GET {{SportMatch_HostAddress}}/games/getall
Accept: application/json

### Get game by id
GET {{SportMatch_HostAddress}}/games/get?id=1
Accept: application/json

### Create a game
# @name create
POST {{SportMatch_HostAddress}}/games/create
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.token}}

{
  "footballFieldId": 1,
  "startTime": "2027-01-01T18:00:00Z",
  "maxPlayers": 10
}

### Delete the game you just created
DELETE {{SportMatch_HostAddress}}/games/delete?id={{create.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.token}}

### Register second user (200, or 409 if it already exists)
POST {{SportMatch_HostAddress}}/Accounts/register
Content-Type: application/json

{ "displayName": "Armandas", "username": "armandas", "password": "test1234" }

### Login as second user
# @name loginOther
POST {{SportMatch_HostAddress}}/Accounts/login
Content-Type: application/json

{ "username": "armandas", "password": "test1234" }

### Delete as NOT the host (expect 403)
DELETE {{SportMatch_HostAddress}}/games/delete?id={{create.response.body.$.id}}
Authorization: Bearer {{loginOther.response.body.$.token}}