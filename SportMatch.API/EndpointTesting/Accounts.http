@SportMatch_HostAddress = http://localhost:5108

### Register
POST {{SportMatch_HostAddress}}/accounts/register
Content-Type: application/json

{
  "displayName": "Karolis",
  "username": "karolis123",
  "password": "test1234"
}

### Login (captures the token for requests below)
# @name login
POST {{SportMatch_HostAddress}}/accounts/login
Content-Type: application/json

{
  "username": "karolis123",
  "password": "test1234"
}

### Get display name (no auth needed)
GET {{SportMatch_HostAddress}}/accounts/getname?username=karolis123

### Change display name (requires token)
POST {{SportMatch_HostAddress}}/accounts/changename
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "newName": "KarolisV2"
}

### Change password (requires token)
POST {{SportMatch_HostAddress}}/accounts/changepass
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "oldPassword": "test1234",
  "newPassword": "newPassword1"
}

### Delete account (requires token)
DELETE {{SportMatch_HostAddress}}/accounts/delete
Authorization: Bearer {{login.response.body.$.token}}
###
