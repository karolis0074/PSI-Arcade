@HostAddress = http://localhost:5108

### Register
POST {{HostAddress}}/Accounts/register
Content-Type: application/json

{
  "displayName": "Karolis",
  "username": "karolis123",
  "password": "test1234"
}

### Login (captures the token for requests below)
# @name login
POST {{HostAddress}}/Accounts/login
Content-Type: application/json

{
  "username": "karolis123",
  "password": "test1234"
}

### Get display name (no auth needed)
GET {{HostAddress}}/Accounts/getname?username=karolis123

### Change display name (requires token)
POST {{HostAddress}}/Accounts/changename
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "newName": "KarolisV2"
}

### Change password (requires token)
POST {{HostAddress}}/Accounts/changepass
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "oldPassword": "test1234",
  "newPassword": "newPassword1"
}

### Delete account (requires token)
DELETE {{HostAddress}}/Accounts/delete
Authorization: Bearer {{login.response.body.$.token}}
###