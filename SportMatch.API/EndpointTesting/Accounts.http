@SportMatch_HostAddress = http://localhost:5108

### Register
POST {{SportMatch_HostAddress}}/accounts
Content-Type: application/json

{
  "username": "karolis123",
  "password": "test1234"
}

### Login (captures the token for requests below)
# @name login
POST {{SportMatch_HostAddress}}/accounts/login
Content-Type: application/json

{
  "username": "karolis123",
  "password": "test1234"
}

### Change password (requires token)
PUT {{SportMatch_HostAddress}}/accounts/me/password
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "oldPassword": "test1234",
  "newPassword": "newPassword1"
}

### Delete account (requires token)
DELETE {{SportMatch_HostAddress}}/accounts/me
Authorization: Bearer {{login.response.body.$.token}}
###
